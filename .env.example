# ── Database ────────────────────────────────────────────────────────────
# Managed runtime supplies DATABASE_URL in server deployments.
# Local: mysql://root:PASSWORD@localhost:3306/especially_for_u
DATABASE_URL=

# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Admin Auth ──────────────────────────────────────────────────────────
# Secret for signing JWT tokens. Change this in production!
JWT_SECRET=change-me-in-production
# Legacy bearer token (still supported alongside JWT)
ADMIN_API_TOKEN=

# Admin accounts (up to 5 supported)
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_1_NAME=Admin One

ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
ADMIN_2_NAME=Admin Two

# ── Razorpay ────────────────────────────────────────────────────────────
# Sign up: https://dashboard.razorpay.com/signup
# Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email Notifications (Gmail via Nodemailer) ──────────────────────────
# Set NOTIFICATIONS_ENABLED=true to activate
NOTIFICATIONS_ENABLED=false
ORDER_NOTIFICATION_EMAIL=
EMAIL_PROVIDER=gmail
# Gmail App Password: Google Account → Security → App Passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
